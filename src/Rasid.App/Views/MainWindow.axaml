<Window
    x:Class="Rasid.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Rasid.App.ViewModels"
    Title="Rasid"
    Width="900"
    Height="600"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">


    <Grid RowDefinitions="Auto, *">
        <TextBlock
            Grid.Row="0"
            Margin="16"
            FontSize="20"
            Text="Watched Channels" />

        <ListBox
            Grid.Row="1"
            Margin="16,0,16,16"
            ItemsSource="{Binding Channels}"
            SelectedItem="{Binding SelectedChannel}">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelItemViewModel">
                    <StackPanel Margin="0,6">
                        <TextBlock FontSize="15" Text="{Binding Name}" />
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="{Binding LastChecked}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </Grid>

</Window>